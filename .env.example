# Variables d'environnement — modèle à recopier en .env.local (jamais versionné).
#
# Elles ne servent QU'À L'ENVOI de l'e-mail du formulaire de rappel
# (src/lib/email/envoi.ts). Le site ne se connecte à aucune base de données :
# une demande transite par cet e-mail, puis n'existe plus nulle part.
#
# Sans ces variables, la page /rendez-vous-psychologue-nantes/ reste en ligne
# et fonctionne : le formulaire affiche alors un message invitant à téléphoner,
# ce qui est de toute façon le canal prioritaire. Aucune demande n'est perdue
# en silence.

# Clé d'API Resend (https://resend.com). À créer côté agence, puis à saisir
# dans les variables d'environnement Vercel — jamais dans le dépôt.
RESEND_API_KEY=

# Expéditeur. DOIT être une adresse d'un domaine vérifié chez Resend, sinon
# l'envoi est refusé. Exemple : site@psychologuenantes-vincentrousseau.fr
EMAIL_EXPEDITEUR=

# Destinataire. Facultatif : par défaut, l'adresse de `contact.email`
# (src/lib/site-config.ts). À renseigner le jour où Vincent bascule du Gmail
# actuel vers une adresse du domaine.
EMAIL_DESTINATAIRE=
