# Variables d'environnement — modèle à recopier en .env.local (jamais versionné).
#
# Elles ne servent QU'À L'ENVOI de l'e-mail du formulaire de rappel
# (src/lib/email/envoi.ts). Le site ne se connecte à aucune base de données :
# une demande transite par cet e-mail, puis n'existe plus nulle part.
#
# Sans ces variables, la page /rendez-vous-psychologue-nantes/ reste en ligne
# et fonctionne : le formulaire affiche alors un message invitant à téléphoner,
# ce qui est de toute façon le canal prioritaire. Aucune demande n'est perdue
# en silence.

# Clé d'API Resend (https://resend.com). À créer côté agence, puis à saisir
# dans les variables d'environnement Vercel — jamais dans le dépôt.
RESEND_API_KEY=

# Expéditeur. DOIT être une adresse d'un domaine vérifié chez Resend, sinon
# l'envoi est refusé. Exemple : site@psychologuenantes-vincentrousseau.fr
EMAIL_EXPEDITEUR=

# Destinataire. Facultatif : par défaut, l'adresse de `contact.email`
# (src/lib/site-config.ts). À renseigner le jour où Vincent bascule du Gmail
# actuel vers une adresse du domaine.
EMAIL_DESTINATAIRE=

# ---------------------------------------------------------------------------
# SUIVI DE PUBLICATION DU BLOG — mail à l'agence, le 1er et le 15 du mois
# (src/app/api/cron/publication-blog/route.ts, planifié dans vercel.json).
# Mêmes identifiants SMTP que le site Clickzou (clickzou-v2/.env.local).
# Aucune donnée de visiteur ne passe par là.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Facultatif : destinataire du point (défaut : jc@clickzou.fr).
BLOG_SUIVI_EMAIL=
# Secret que Vercel joint à l'appel du cron. SANS LUI, LA ROUTE REFUSE TOUT.
# Chaîne aléatoire longue, propre à ce projet — ne pas reprendre celle de Clickzou.
CRON_SECRET=

# ---------------------------------------------------------------------------
# OUTILS GOOGLE — à renseigner UNE FOIS LE DOMAINE DÉFINITIF EN LIGNE.
# Les deux sont indépendants et n'ont pas le même régime juridique.
# ---------------------------------------------------------------------------

# Search Console. Simple balise <meta> prouvant la propriété du domaine.
# Ne dépose aucun cookie, ne suit personne, N'EXIGE AUCUN CONSENTEMENT.
# À poser dès la mise en ligne : Search Console n'a aucun historique
# rétroactif, chaque semaine de retard est une semaine de données perdue.
# Valeur = le contenu de l'attribut `content` fourni par Google.
GOOGLE_SITE_VERIFICATION=

# Google Analytics 4, de la forme « G-XXXXXXXXXX ».
# ⚠️ Renseigner cette variable ACTIVE la bannière de consentement et modifie
# automatiquement la politique de confidentialité et les mentions légales,
# qui dépendent de sa présence. Tant qu'elle est vide : aucune bannière,
# aucun script, aucun cookie.
# Le script n'est chargé qu'après un « Accepter » explicite.
NEXT_PUBLIC_GA_ID=
